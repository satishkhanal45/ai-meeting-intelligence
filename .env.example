# AI Meeting Intelligence - API Configuration
# Copy this file to .env and fill in your API keys.
# At least one provider must be configured.
#
# Do NOT quote values: Docker's --env-file and compose's env_file: pass quotes
# through literally, which breaks validation inside a container.

# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default provider (gemini | groq | openrouter)
DEFAULT_PROVIDER=groq

# Default LLM parameters
DEFAULT_TEMPERATURE=0.3
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
